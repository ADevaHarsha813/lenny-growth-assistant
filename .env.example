# ─── LLM Provider ────────────────────────────────────────────────────────────
# Set to "anthropic" for cloud or "ollama" for local demo
LLM_PROVIDER=ollama

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data

# ─── App ─────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-32-char-string-in-production
CORS_ORIGINS=http://localhost:3000
